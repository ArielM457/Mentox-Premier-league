FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

WORKDIR /workspace

RUN python -m pip install --no-cache-dir "uv>=0.8,<1"

COPY apps/backend/pyproject.toml apps/backend/uv.lock /workspace/apps/backend/
RUN uv sync --project /workspace/apps/backend --frozen --no-dev --no-install-project

COPY apps/backend/src /workspace/apps/backend/src
COPY apps/backend/scripts /workspace/apps/backend/scripts
RUN uv sync --project /workspace/apps/backend --frozen --no-dev
COPY experiments/video_sync_diagnostic /workspace/experiments/video_sync_diagnostic

EXPOSE 8018

CMD ["uvicorn", "video_sync_diagnostic.app:app", "--app-dir", "/workspace/experiments", "--host", "0.0.0.0", "--port", "8018"]
