EVENT_TRANSPORT=memory
EVENT_PRODUCER=synthetic-generator

# Persistencia opcional en Supabase. La clave secreta solo se usa en backend.
SUPABASE_ENABLED=false
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<secret-local-no-commit>
SUPABASE_PROJECT_REF=<project-ref>

# provisional mantiene la demo determinista; fixture usa Persona 3 sin red;
# azure conecta Persona 3 con CrewAI y los despliegues configurados abajo.
NARRATIVE_PROVIDER=provisional
# AZURE_OPENAI_ENDPOINT=https://<recurso>.cognitiveservices.azure.com
# AZURE_OPENAI_DEPLOYMENT=narrativa-calidad
# AZURE_OPENAI_ROUTER_DEPLOYMENT=clasificacion-rapida
# AZURE_OPENAI_NARRATIVE_DEPLOYMENT=narrativa-calidad
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=<secret-local-no-commit>

# Requeridas únicamente cuando EVENT_TRANSPORT=azure_event_hubs.
# EVENT_HUB_FULLY_QUALIFIED_NAMESPACE=<namespace>.servicebus.windows.net
# EVENT_HUB_NAME=match-events
# EVENT_HUB_CONSUMER_GROUP=backend

# Canal separado para observaciones de Roboflow, SoccerNet y fusión.
VISION_OBSERVATION_TRANSPORT=memory
# VISION_EVENT_HUB_NAME=vision-observations
# VISION_EVENT_HUB_CONSUMER_GROUP=backend

# Inferencia en vivo: la clave queda únicamente en el backend.
# ROBOFLOW_SUITE_ENDPOINT=https://ca-mentox-roboflow-dev.<region>.azurecontainerapps.io
# ROBOFLOW_SUITE_API_KEY=<secreto-local-no-commit>
# MENTOX_MODEL_API_KEY=<compatibilidad-temporal-si-no-usa-la-clave-especifica>
# VISION_CAPTURE_INTERVAL_MS=1000

# Análisis temporal del MP4 antes de Play. Use una clave distinta por servicio.
# SOCCERNET_ENDPOINT=https://ca-mentox-teamspotting-dev.<region>.azurecontainerapps.io
# SOCCERNET_API_KEY=<secreto-local-no-commit>
# SOCCERNET_TIMEOUT_SECONDS=900

# GameState: retirado de la demo MESSI el 2026-10-27; servicio Azure eliminado.
SOCCERNET_GAMESTATE_ENABLED=false
VISION_SIMULATOR_ENABLED=auto
# auto carga manifest.json, events.jsonl, tracking.jsonl y metadata.jsonl
# junto al VISION_VIDEO_BLOB_NAME. Verifica hashes antes de sustituir a Ariel.
# Mantener sin configurar. Si hay exports anteriores, quitar ENDPOINT y API_KEY
# de la terminal que arranca el backend y reiniciarlo. Código solo experimental.
# Reconstrucción de estado del vídeo antes de Play (API asíncrona).
# SOCCERNET_GAMESTATE_ENDPOINT=https://ca-mentox-gamestate-dev.<region>.azurecontainerapps.io
# SOCCERNET_GAMESTATE_API_KEY=<secreto-local-no-commit>
# SOCCERNET_GAMESTATE_TIMEOUT_SECONDS=3600
# SOCCERNET_GAMESTATE_POLL_SECONDS=5
# SOCCERNET_GAMESTATE_SAMPLE_INTERVAL_MS=1000
# El lado/cluster de GameState no identifica local/visitante automáticamente.
# Use IDs reales de los metadatos del partido, tras comprobarlos en ese vídeo.
# SOCCERNET_GAMESTATE_TEAM_BY_SIDE={"left":"<team-id-izquierda>","right":"<team-id-derecha>"}
# Active solo si la plantilla del backend corresponde al MP4 analizado.
# SOCCERNET_GAMESTATE_ROSTER_VERIFIED=false

# Con alguno de los modelos configurado, el backend prepara el partido
# en segundo plano al arrancar. Use false para exigir preparación manual.
# VISION_PREPARE_ON_STARTUP=true
# VISION_STARTUP_MATCH_ID=synthetic-live-001

# Requerida únicamente para la prueba manual de Blob Storage de DV-US-09.
# AZURE_BLOB_SERVICE_ENDPOINT=https://<storage-account>.blob.core.windows.net
# VISION_VIDEO_CONTAINER=synthetic-videos
# VISION_VIDEO_BLOB_NAME=messi/<lote>/messi-001/match.mp4

# Separación de eventos reconstruibles e importantes.
# ROUTING_TRANSPORT=azure
# METRICS_EVENT_HUB_NAME=match-metrics
# SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=<namespace>.servicebus.windows.net
# IMPORTANT_EVENTS_QUEUE_NAME=important-events

# Salidas de la analítica (Persona 2). memory no necesita Azure.
ANALYTICS_OUTPUT=memory
# Requeridas únicamente cuando ANALYTICS_OUTPUT=azure, además de
# EVENT_HUB_FULLY_QUALIFIED_NAMESPACE y AZURE_BLOB_SERVICE_ENDPOINT.
# INSIGHTS_EVENT_HUB_NAME=match-insights
# ANALYTICS_BLOB_CONTAINER=analytics
# VALUE_MODELS_SOURCE=none
