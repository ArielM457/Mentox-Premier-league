EVENT_TRANSPORT=memory
EVENT_PRODUCER=synthetic-generator

# Persistencia opcional en Supabase. La clave secreta solo se usa en backend.
SUPABASE_ENABLED=false
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<secret-local-no-commit>
SUPABASE_PROJECT_REF=<project-ref>

# provisional mantiene la demo determinista; fixture usa Persona 3 sin red;
# azure conecta Persona 3 con CrewAI y los despliegues configurados abajo.
NARRATIVE_PROVIDER=provisional
# AZURE_OPENAI_ENDPOINT=https://<recurso>.cognitiveservices.azure.com
# AZURE_OPENAI_DEPLOYMENT=narrativa-calidad
# AZURE_OPENAI_ROUTER_DEPLOYMENT=clasificacion-rapida
# AZURE_OPENAI_NARRATIVE_DEPLOYMENT=narrativa-calidad
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=<secret-local-no-commit>

# Requeridas únicamente cuando EVENT_TRANSPORT=azure_event_hubs.
# EVENT_HUB_FULLY_QUALIFIED_NAMESPACE=<namespace>.servicebus.windows.net
# EVENT_HUB_NAME=match-events
# EVENT_HUB_CONSUMER_GROUP=backend

# Requerida únicamente para la prueba manual de Blob Storage de DV-US-09.
# AZURE_BLOB_SERVICE_ENDPOINT=https://<storage-account>.blob.core.windows.net

# Salidas de la analítica (Persona 2). memory no necesita Azure.
ANALYTICS_OUTPUT=memory
# Requeridas únicamente cuando ANALYTICS_OUTPUT=azure, además de
# EVENT_HUB_FULLY_QUALIFIED_NAMESPACE y AZURE_BLOB_SERVICE_ENDPOINT.
# INSIGHTS_EVENT_HUB_NAME=match-insights
# ANALYTICS_BLOB_CONTAINER=analytics
# VALUE_MODELS_SOURCE=none
